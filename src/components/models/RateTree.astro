---
/**
 * Binomial interest rate tree (CFA Level II fixed income). Calibrated to a par
 * curve with lognormal rate volatility, used to price an option-free bond and a
 * callable bond, solve the option-adjusted spread for a market price, and
 * compute effective duration and convexity by shifting the whole curve.
 */
interface Props {
  id: string;
  title?: string;
  note?: string;
}
const { id, title = 'Binomial rate tree: callable bond, OAS, effective duration', note } = Astro.props;
---

<div class="model" data-model="ratetree" id={id}>
  <div class="model-head">
    <p class="model-title">{title}</p>
    {note && <p class="model-note">{note}</p>}
  </div>
  <div class="controls">
    <label class="ctl"><span class="lab"><span>1-yr par rate</span><output data-o="y1">3.80%</output></span><input type="range" min="0.005" max="0.08" step="0.0005" value="0.038" data-in="y1" /></label>
    <label class="ctl"><span class="lab"><span>5-yr par rate</span><output data-o="y5">4.00%</output></span><input type="range" min="0.005" max="0.08" step="0.0005" value="0.04" data-in="y5" /></label>
    <label class="ctl"><span class="lab"><span>Rate volatility σ</span><output data-o="vol">15%</output></span><input type="range" min="0.05" max="0.4" step="0.01" value="0.15" data-in="vol" /></label>
    <label class="ctl"><span class="lab"><span>Coupon</span><output data-o="cpn">5.00%</output></span><input type="range" min="0.01" max="0.09" step="0.0025" value="0.05" data-in="cpn" /></label>
    <label class="ctl"><span class="lab"><span>Call price</span><output data-o="call">100.0</output></span><input type="range" min="98" max="106" step="0.25" value="100" data-in="call" /></label>
    <label class="ctl"><span class="lab"><span>First call (year)</span><output data-o="fc">1</output></span><input type="range" min="1" max="4" step="1" value="1" data-in="fc" /></label>
    <label class="ctl"><span class="lab"><span>Market price of callable</span><output data-o="px">101.0</output></span><input type="range" min="90" max="110" step="0.125" value="101" data-in="px" /></label>
    <label class="ctl"><span class="lab"><span>Shock for duration (bp)</span><output data-o="dy">25</output></span><input type="range" min="5" max="100" step="5" value="25" data-in="dy" /></label>
  </div>
  <div class="stats">
    <div class="stat"><div class="k">Option-free value</div><div class="v" data-out="vs">–</div></div>
    <div class="stat"><div class="k">Callable value (zero spread)</div><div class="v" data-out="vc">–</div></div>
    <div class="stat"><div class="k">Value of the call option</div><div class="v" data-out="vo">–</div></div>
    <div class="stat"><div class="k">OAS at market price</div><div class="v" data-out="oas">–</div></div>
    <div class="stat"><div class="k">Effective duration (callable)</div><div class="v" data-out="ed">–</div><div class="k" data-out="eds">–</div></div>
    <div class="stat"><div class="k">Effective convexity (callable)</div><div class="v" data-out="ec">–</div><div class="k" data-out="ecs">–</div></div>
  </div>
  <div class="two-col">
    <div>
      <p class="readout">Calibrated one-year forward rates (five-year tree, lognormal, up/down ratio e<sup>2σ</sup>).</p>
      <div class="table-scroll"><table><thead><tr><th>Year</th><th>Lowest node</th><th>…</th><th>Highest node</th><th>Nodes</th></tr></thead><tbody data-out="tree"></tbody></table></div>
    </div>
    <div>
      <svg class="pc" viewBox="0 0 360 240" role="img" aria-label="Price versus parallel curve shift"></svg>
      <div class="legend"><span><i style="background: var(--c1)"></i>Option-free bond</span><span><i style="background: var(--c2)"></i>Callable bond</span><span><i style="background: var(--muted)"></i>Call price</span></div>
    </div>
  </div>
</div>

<script>
  import { fmt, bisect } from '../../lib/stats';
  import { el, clear, axes, path, scale } from '../../lib/svg';

  const N = 5;

  /** Par curve: linear interpolation between the 1-year and 5-year rates. */
  const parCurve = (y1: number, y5: number, shift = 0) => Array.from({ length: N }, (_, i) => y1 + ((y5 - y1) * i) / (N - 1) + shift);

  /** Price a bond with coupon c on a given tree with spread s; call rule optional. */
  function priceOnTree(tree: number[][], c: number, s: number, call?: { px: number; from: number }): number {
    let vals = new Array(N + 1).fill(100 + 100 * c); // cash flow at maturity (par + coupon)
    for (let t = N - 1; t >= 0; t--) {
      const next = new Array(t + 1);
      for (let i = 0; i <= t; i++) {
        const r = tree[t][i] + s;
        // Value at node (t, i) of all cash flows after time t, discounted one year at the node rate.
        let v = (0.5 * (vals[i] + vals[i + 1])) / (1 + r);
        // The issuer may call at time t (t >= first call year) by paying the call price instead.
        if (call && t >= call.from) v = Math.min(v, call.px);
        next[i] = v + (t > 0 ? 100 * c : 0); // add the coupon paid at time t
      }
      vals = next;
    }
    return vals[0];
  }

  /** Calibrate the lowest node of each year so that par bonds price at par. */
  function calibrate(par: number[], vol: number): number[][] {
    const tree: number[][] = [];
    for (let t = 0; t < N; t++) {
      const f = (r0: number) => {
        const row = Array.from({ length: t + 1 }, (_, i) => r0 * Math.exp(2 * vol * i));
        const trial = [...tree, row];
        // Price a (t+1)-year par bond with coupon par[t] using the partial tree.
        let vals = new Array(t + 2).fill(100 + 100 * par[t]);
        for (let k = t; k >= 0; k--) {
          const next = new Array(k + 1);
          for (let i = 0; i <= k; i++) next[i] = (0.5 * (vals[i] + vals[i + 1])) / (1 + trial[k][i]) + (k > 0 ? 100 * par[t] : 0);
          vals = next;
        }
        return vals[0] - 100;
      };
      const r0 = bisect(f, 0.0001, 0.5, 1e-9);
      tree.push(Array.from({ length: t + 1 }, (_, i) => r0 * Math.exp(2 * vol * i)));
    }
    return tree;
  }

  function init(root: HTMLElement) {
    const q = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const o = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const svg = root.querySelector<SVGSVGElement>('svg.pc')!;

    const update = () => {
      const y1 = +q('y1').value, y5 = +q('y5').value, vol = +q('vol').value, c = +q('cpn').value;
      const callPx = +q('call').value, fc = +q('fc').value, px = +q('px').value, dy = +q('dy').value / 10000;
      o('y1').textContent = fmt.pct(y1, 2); o('y5').textContent = fmt.pct(y5, 2); o('vol').textContent = fmt.pct(vol, 0); o('cpn').textContent = fmt.pct(c, 2);
      o('call').textContent = callPx.toFixed(1); o('fc').textContent = String(fc); o('px').textContent = px.toFixed(3); o('dy').textContent = String(Math.round(dy * 10000));

      const call = { px: callPx, from: fc };
      const tree = calibrate(parCurve(y1, y5), vol);
      const vs = priceOnTree(tree, c, 0);
      const vc = priceOnTree(tree, c, 0, call);
      out('vs').textContent = vs.toFixed(3);
      out('vc').textContent = vc.toFixed(3);
      out('vo').textContent = (vs - vc).toFixed(3);

      const f = (s: number) => priceOnTree(tree, c, s, call) - px;
      const oas = f(-0.05) * f(0.1) < 0 ? bisect(f, -0.05, 0.1, 1e-9) : NaN;
      out('oas').textContent = Number.isNaN(oas) ? 'no solution' : fmt.bp(oas);

      // Effective duration/convexity at constant OAS: rebuild the tree on shifted curves.
      const sOas = Number.isNaN(oas) ? 0 : oas;
      const up = priceOnTree(calibrate(parCurve(y1, y5, dy), vol), c, sOas, call);
      const dn = priceOnTree(calibrate(parCurve(y1, y5, -dy), vol), c, sOas, call);
      const p0 = priceOnTree(tree, c, sOas, call);
      const ed = (dn - up) / (2 * p0 * dy);
      const ec = (dn + up - 2 * p0) / (p0 * dy * dy);
      const upS = priceOnTree(calibrate(parCurve(y1, y5, dy), vol), c, sOas);
      const dnS = priceOnTree(calibrate(parCurve(y1, y5, -dy), vol), c, sOas);
      const p0S = priceOnTree(tree, c, sOas);
      out('ed').textContent = ed.toFixed(2);
      out('eds').textContent = `option-free: ${((dnS - upS) / (2 * p0S * dy)).toFixed(2)}`;
      const ece = out('ec');
      ece.textContent = ec.toFixed(1);
      ece.className = 'v ' + (ec < 0 ? 'neg' : '');
      out('ecs').textContent = `option-free: ${((dnS + upS - 2 * p0S) / (p0S * dy * dy)).toFixed(1)}`;

      out('tree').innerHTML = tree.map((row, t) => `<tr><td>${t + 1}</td><td>${fmt.pct(row[0], 3)}</td><td>${row.length > 2 ? '…' : ''}</td><td>${fmt.pct(row[row.length - 1], 3)}</td><td>${row.length}</td></tr>`).join('');

      // Price vs parallel shift, -200..+200 bp.
      clear(svg);
      const shifts: number[] = [], ps: number[] = [], pc: number[] = [];
      for (let b = -200; b <= 200; b += 20) {
        const tr = calibrate(parCurve(y1, y5, b / 10000), vol);
        shifts.push(b); ps.push(priceOnTree(tr, c, sOas)); pc.push(priceOnTree(tr, c, sOas, call));
      }
      const box = { left: 46, right: 350, top: 12, bottom: 205 };
      const lo = Math.min(...ps, ...pc) - 2, hi = Math.max(...ps, ...pc) + 2;
      const sx = scale(-200, 200, box.left, box.right), sy = scale(lo, hi, box.bottom, box.top);
      const g = el('g');
      axes(g, sx, sy, [-200, 200], [lo, hi], box, (v) => `${v > 0 ? '+' : ''}${v}`, (v) => v.toFixed(0));
      svg.appendChild(g);
      svg.appendChild(el('line', { x1: box.left, x2: box.right, y1: sy(callPx), y2: sy(callPx), stroke: 'var(--muted)', 'stroke-dasharray': '4 3' }));
      svg.appendChild(el('path', { d: path(shifts.map((s, i) => [sx(s), sy(ps[i])])), fill: 'none', stroke: 'var(--c1)', 'stroke-width': 2.5 }));
      svg.appendChild(el('path', { d: path(shifts.map((s, i) => [sx(s), sy(pc[i])])), fill: 'none', stroke: 'var(--c2)', 'stroke-width': 2.5 }));
      svg.appendChild(el('text', { x: (box.left + box.right) / 2, y: 232, class: 'lbl muted', 'text-anchor': 'middle' }, 'parallel shift of the par curve (bp)'));
    };
    ['y1', 'y5', 'vol', 'cpn', 'call', 'fc', 'px', 'dy'].forEach((k) => q(k).addEventListener('input', update));
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-model="ratetree"]').forEach(init);
</script>
