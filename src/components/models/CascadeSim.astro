---
/**
 * Bikhchandani-Hirshleifer-Welch information cascade, simulated.
 * Agents act in sequence, each with a private binary signal of accuracy s.
 * Once the public record of inferred signals leans two to one side, every
 * later agent rationally ignores their own signal: a cascade.
 */
interface Props {
  id: string;
  title?: string;
  note?: string;
}
const { id, title = 'Information cascade simulator', note } = Astro.props;
---

<div class="model" data-model="cascade" id={id}>
  <div class="model-head">
    <p class="model-title">{title}</p>
    {note && <p class="model-note">{note}</p>}
  </div>
  <div class="controls">
    <label class="ctl">
      <span class="lab"><span>Signal accuracy (s)</span><output data-o="s">70%</output></span>
      <input type="range" min="0.51" max="0.95" step="0.01" value="0.7" data-in="s" />
    </label>
    <label class="ctl">
      <span class="lab"><span>Agents per run (N)</span><output data-o="n">60</output></span>
      <input type="range" min="10" max="200" step="5" value="60" data-in="n" />
    </label>
    <label class="ctl">
      <span class="lab"><span>Monte Carlo runs</span><output data-o="m">2000</output></span>
      <input type="range" min="200" max="10000" step="200" value="2000" data-in="m" />
    </label>
    <div class="ctl">
      <span class="lab"><span>Seed</span><output data-o="seed">1</output></span>
      <button type="button" class="btn ghost small" data-act="reseed">Re-run with new seed</button>
    </div>
  </div>
  <div class="stats">
    <div class="stat"><div class="k">Correct cascade</div><div class="v pos" data-out="good">–</div></div>
    <div class="stat"><div class="k">Wrong cascade</div><div class="v neg" data-out="bad">–</div></div>
    <div class="stat"><div class="k">No cascade by agent N</div><div class="v" data-out="none">–</div></div>
    <div class="stat"><div class="k">Median onset (agent #)</div><div class="v" data-out="onset">–</div></div>
    <div class="stat"><div class="k">Share of agents acting on own signal</div><div class="v" data-out="own">–</div></div>
    <div class="stat"><div class="k">Theory: P(wrong) from first two agents</div><div class="v" data-out="theory">–</div></div>
  </div>
  <div class="two-col">
    <div>
      <svg class="hist" viewBox="0 0 360 200" role="img" aria-label="Histogram of cascade onset"></svg>
      <div class="legend"><span><i style="background: var(--c1)"></i>Correct cascades</span><span><i style="background: var(--c2)"></i>Wrong cascades</span></div>
    </div>
    <div>
      <svg class="strip" viewBox="0 0 360 200" role="img" aria-label="One sample run"></svg>
      <div class="legend">
        <span><i style="background: var(--c1); border-radius: 50%"></i>Acted on own signal</span>
        <span><i style="background: var(--c6); border-radius: 50%"></i>Followed the herd</span>
        <span><i style="background: var(--neg); border-radius: 50%"></i>Herd was wrong</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { rng, fmt, quantile } from '../../lib/stats';
  import { el, clear } from '../../lib/svg';

  interface Run { type: 'good' | 'bad' | 'none'; onset: number; own: number; actions: number[]; signals: number[]; state: number }

  function simulate(s: number, N: number, M: number, seed: number) {
    const u = rng(seed);
    const runs: Run[] = [];
    for (let r = 0; r < M; r++) {
      const state = u() < 0.5 ? 1 : -1;
      let diff = 0, onset = -1, own = 0;
      const actions: number[] = [], signals: number[] = [];
      for (let i = 0; i < N; i++) {
        const sig = u() < s ? state : -state;
        signals.push(sig);
        let act: number;
        if (diff >= 2) act = 1;
        else if (diff <= -2) act = -1;
        else {
          act = sig; // |diff| <= 1: own signal is decisive (ties broken toward own signal)
          diff += sig;
          own++;
        }
        if (onset < 0 && Math.abs(diff) >= 2) onset = i + 1;
        actions.push(act);
      }
      const type: Run['type'] = onset < 0 ? 'none' : Math.sign(diff) === state ? 'good' : 'bad';
      runs.push({ type, onset, own, actions, signals, state });
    }
    return runs;
  }

  function init(root: HTMLElement) {
    const q = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const o = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const hist = root.querySelector<SVGSVGElement>('svg.hist')!;
    const strip = root.querySelector<SVGSVGElement>('svg.strip')!;
    let seed = 1;

    const update = () => {
      const s = +q('s').value, N = +q('n').value, M = +q('m').value;
      o('s').textContent = fmt.pct(s, 0); o('n').textContent = String(N); o('m').textContent = String(M); o('seed').textContent = String(seed);
      const runs = simulate(s, N, M, seed);
      const good = runs.filter((r) => r.type === 'good').length / M;
      const bad = runs.filter((r) => r.type === 'bad').length / M;
      const none = runs.filter((r) => r.type === 'none').length / M;
      const onsets = runs.filter((r) => r.onset > 0).map((r) => r.onset).sort((a, b) => a - b);
      out('good').textContent = fmt.pct(good, 1);
      out('bad').textContent = fmt.pct(bad, 1);
      out('none').textContent = fmt.pct(none, 1);
      out('onset').textContent = onsets.length ? String(Math.round(quantile(onsets, 0.5))) : '–';
      out('own').textContent = fmt.pct(runs.reduce((a, r) => a + r.own, 0) / (M * N), 1);
      // Closed form: a cascade forms after agents 1 and 2 with probability s^2 + (1-s)^2, the wrong way with (1-s)^2.
      // Conditional on the first pair not cascading, the process restarts, so overall P(wrong) = (1-s)^2 / (s^2 + (1-s)^2).
      const pw = (1 - s) ** 2 / (s ** 2 + (1 - s) ** 2);
      out('theory').textContent = fmt.pct(pw, 1);

      // Histogram of onset by type.
      clear(hist);
      const bins = 12;
      const binW = Math.max(1, Math.ceil(N / bins));
      const cnt = { good: new Array(bins).fill(0), bad: new Array(bins).fill(0) };
      for (const r of runs) if (r.onset > 0 && r.type !== 'none') cnt[r.type][Math.min(bins - 1, Math.floor((r.onset - 1) / binW))]++;
      const maxC = Math.max(1, ...cnt.good.map((g, i) => g + cnt.bad[i]));
      const L = 34, R = 350, T = 10, B = 170;
      const bw = (R - L) / bins;
      for (let i = 0; i < bins; i++) {
        const hg = ((B - T) * cnt.good[i]) / maxC, hb = ((B - T) * cnt.bad[i]) / maxC;
        hist.appendChild(el('rect', { x: L + i * bw + 1, y: B - hg, width: bw - 2, height: hg, fill: 'var(--c1)' }));
        hist.appendChild(el('rect', { x: L + i * bw + 1, y: B - hg - hb, width: bw - 2, height: hb, fill: 'var(--c2)' }));
        if (i % 3 === 0) hist.appendChild(el('text', { x: L + i * bw + 1, y: B + 14, class: 'tick' }, String(i * binW + 1)));
      }
      hist.appendChild(el('line', { x1: L, x2: R, y1: B, y2: B, class: 'axis' }));
      hist.appendChild(el('text', { x: (L + R) / 2, y: B + 28, class: 'lbl muted', 'text-anchor': 'middle' }, 'agent at which the cascade began'));
      hist.appendChild(el('text', { x: L - 4, y: T + 10, class: 'tick', 'text-anchor': 'end' }, String(maxC)));

      // Sample run strip: first run of the batch.
      clear(strip);
      const r0 = runs[0];
      const show = Math.min(N, 60);
      const cols = 12, rows = Math.ceil(show / cols);
      const cw = 340 / cols, rh = Math.min(28, 170 / rows);
      for (let i = 0; i < show; i++) {
        const cx = 20 + (i % cols) * cw + cw / 2, cy = 16 + Math.floor(i / cols) * rh + rh / 2;
        const ownAct = i < r0.actions.length && (r0.onset < 0 || i + 1 <= r0.onset);
        const herd = !ownAct;
        const wrong = herd && r0.actions[i] !== r0.state;
        const fill = wrong ? 'var(--neg)' : herd ? 'var(--c6)' : 'var(--c1)';
        strip.appendChild(el('circle', { cx, cy, r: Math.min(9, rh / 2 - 2), fill }));
        strip.appendChild(el('text', { x: cx, y: cy + 3.5, 'text-anchor': 'middle', 'font-size': 9, fill: 'var(--accent-ink)', class: 'mono' }, r0.actions[i] > 0 ? '↑' : '↓'));
      }
      strip.appendChild(el('text', { x: 20, y: 192, class: 'tick' }, `Sample run: true state ${r0.state > 0 ? 'UP' : 'DOWN'}, cascade ${r0.onset > 0 ? `from agent ${r0.onset} (${r0.type === 'good' ? 'correct' : 'wrong'})` : 'never formed'}`));
    };

    ['s', 'n', 'm'].forEach((k) => q(k).addEventListener('input', update));
    root.querySelector('[data-act="reseed"]')!.addEventListener('click', () => { seed = (seed * 7 + 13) % 10007; update(); });
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-model="cascade"]').forEach(init);
</script>
