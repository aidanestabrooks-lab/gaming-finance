---
import { url, tagSlug } from '../consts';

interface Props {
  tag: string;
  link?: boolean;
}

const { tag, link = true } = Astro.props;
---

{
  link ? (
    <a class="pill" href={url(`/projects#${tagSlug(tag)}`)}>{tag}</a>
  ) : (
    <span class="pill">{tag}</span>
  )
}

<style>
  .pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    text-decoration: none;
    white-space: nowrap;
  }
  a.pill:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
