---
import { BUTTONDOWN_USERNAME } from '../consts';
const ready = BUTTONDOWN_USERNAME.length > 0;
const action = ready
  ? `https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`
  : '#newsletter';
---

<section id="newsletter" class="newsletter">
  <div class="wrap inner">
    <div class="copy">
      <p class="kicker">Newsletter</p>
      <h2>One project a week, in your inbox</h2>
      <p>
        Every week, one firm, event, or market situation worked through from first principles.
        No hot takes, no tickers to chase. Unsubscribe any time.
      </p>
    </div>
    <form class="form" action={action} method="post" target={ready ? '_blank' : undefined}>
      <label class="sr-only" for="bd-email">Email address</label>
      <input
        id="bd-email"
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
        disabled={!ready}
      />
      <button class="btn" type="submit" disabled={!ready}>Subscribe</button>
      {!ready && <p class="pending">Signup opens soon.</p>}
    </form>
  </div>
</section>

<style>
  .newsletter {
    margin-top: 4rem;
    background: var(--accent);
    color: var(--accent-ink);
  }
  .inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: center;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .kicker {
    color: var(--gold);
  }
  .copy h2 {
    color: inherit;
  }
  .copy p:last-child {
    margin: 0;
    opacity: 0.85;
  }
  .form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.6rem;
  }
  input {
    font: inherit;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius);
    border: 1px solid transparent;
    background: var(--bg);
    color: var(--text);
    min-width: 0;
  }
  input:focus {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }
  .form .btn {
    background: var(--gold);
    border-color: var(--gold);
    color: #1b1b1f;
  }
  .pending {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 2.2rem;
      padding-bottom: 2.2rem;
    }
  }
  @media (max-width: 420px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>
